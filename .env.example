OPENAI_API_KEY=your_openai_api_key

# Alternative to OPENAI_API_KEY for text-based NVIDIA NIM examples. When this
# is set, sitecustomize.py automatically routes the Agents SDK to NIM's
# Chat Completions endpoint. Choose a chat model available in NVIDIA's catalog.
# NVIDIA_API_KEY=nvapi-your_nvidia_api_key
# PYTHONPATH=.

# NVIDIA NIM model selection. Use a chat model for agents and select exactly
# one embedding model for embedding examples.
# NIM_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
# Alternative: nvidia/nemotron-3.5-embed-1b

# Brave Search API key, used by the chapter 9 and 10 research agents
# (https://brave.com/search/api/)
BRAVE_API_KEY=your_brave_api_key

# Model for every agent that does not name one. If using NVIDIA NIM, replace
# this OpenAI model ID with a NIM chat model ID, for example:
# OPENAI_DEFAULT_MODEL=meta/muse-glimmer-30b
OPENAI_DEFAULT_MODEL=gpt-5.1
