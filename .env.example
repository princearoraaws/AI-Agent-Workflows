# Choose exactly ONE provider section below. Leave the other two sections
# fully commented out. The key variable must be the only enabled one of
# OPENAI_API_KEY, CUSTOM_LLM_API_KEY, and NVIDIA_API_KEY.

# --- OpenAI ---
# Uncomment these two lines for OpenAI. Keep Custom LLM and NVIDIA commented.
OPENAI_API_KEY=your_openai_api_key
OPENAI_DEFAULT_MODEL=gpt-5.1

# --- Custom OpenAI-compatible LLM ---
# Uncomment these lines for a custom provider. Comment out the OpenAI and
# NVIDIA sections. PYTHONPATH is required when running from a terminal.
# CUSTOM_LLM_API_KEY=your_custom_llm_api_key
# CUSTOM_LLM_BASE_URL=https://your-provider.example/v1
# CUSTOM_LLM_MODEL=your-provider-chat-model
# PYTHONPATH=.

# --- NVIDIA NIM ---
# Uncomment these lines for NVIDIA NIM. Comment out the OpenAI and Custom LLM
# sections. PYTHONPATH is required when running from a terminal.
# NVIDIA_API_KEY=nvapi-your_nvidia_api_key
# OPENAI_DEFAULT_MODEL=meta/muse-glimmer-30b
# NIM_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
# PYTHONPATH=.

# --- Optional shared services ---
# Required only by the chapter 9 and 10 research agents.
BRAVE_API_KEY=your_brave_api_key
